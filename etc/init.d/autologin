#!/sbin/openrc-run

description="Autologin a user on a VT and run their session script"

supervisor=supervise-daemon
command=/usr/local/sbin/autologin
command_args="${AUTOLOGIN_CONF:-/etc/autologin.conf}"
error_log=/var/log/autologin.log
respawn_delay=2
respawn_max=5
respawn_period=60

depend() {
	after bootmisc
	need localmount seatd
	use dbus
}

start_pre() {
	checkpath -f -m 0644 -o root:root "${AUTOLOGIN_CONF:-/etc/autologin.conf}"
}
